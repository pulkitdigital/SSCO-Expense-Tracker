PORT=5000
FRONTEND_URL=http://localhost:3000
DB_PATH=./data/expenses.db

# -----------------------------------------------------------------------------
# Firebase Admin (cloud sync) — optional; API works without it
# -----------------------------------------------------------------------------
#
# RECOMMENDED: download your service account JSON from Firebase Console
# (Project settings → Service accounts → Generate new private key)
# and save it as:
#   Backend/serviceAccountKey.json
#
# ALTERNATIVE: set these three variables in .env (no trailing commas on values)
#
# FIREBASE_PROJECT_ID=your-project-id
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
#
# Private key as ONE line with literal \n between lines (wrap in double quotes):
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
#
# Or point to any JSON key file:
# GOOGLE_APPLICATION_CREDENTIALS=./path/to/serviceAccountKey.json
